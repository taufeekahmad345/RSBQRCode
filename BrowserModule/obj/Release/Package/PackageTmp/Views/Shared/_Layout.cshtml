    <style>
        /* Reset some default styles */
        body, ul {
            margin: 0;
            padding: 0;
        }

        .navbar {
            background-color: #e7dcdc;
            font-family: Arial, sans-serif;
            padding: 0;
        }

            .navbar ul {
                list-style: none;
                display: flex;
            }

            .navbar li {
                position: relative;
            }

                .navbar li a {
                    display: block;
                    padding: 14px 20px;
                    color: black;
                    text-decoration: none;
                }

                    .navbar li a:hover {
                        background-color: #fbd9d9;
                    }

        /* Dropdown styles */
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #e7dcdc;
            min-width: 160px;
            z-index: 1;
        }

            .dropdown-content a {
                color: white;
                padding: 12px 16px;
                text-decoration: none;
            }

                .dropdown-content a:hover {
                    background-color: #fbd9d9;
                }

        /* Show the dropdown menu when hovering over the dropdown */
        .dropdown:hover .dropdown-content {
            display: block;
        }

        .dropdown:hover > .dropbtn {
            background-color: #fbd9d9;
        }



    </style>
</head>

<body>

