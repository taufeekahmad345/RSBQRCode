            <script>
    $(document).ready(function () {
        $(".sidebar-nav li > .sub-menu").parent().hover(function () {
            var submenu = $(this).children(".sub-menu");
            if ($(submenu).is(":hidden")) {
                $(submenu).slideDown(200);

            }
            else {
                $(submenu).slideUp(200);
            }
        })
        var timeoutVal = 900;
        if (@Session["Timeout"] != null) {
            timeoutVal = Number("@Session["Timeout"].ToString()");
        }
            $.jTimeout({
                // flash the tab/title bar when or after timing out
                flashTitle: true,
                // flash speed in milliseconds
                flashTitleSpeed: 500,
                // text to show in the tab/title bar
                flashingTitleText: 'Session Expired',
                // original page title
                originalTitle: document.title,
                // timeout in seconds
                timeoutAfter: timeoutVal,
                // seconds in between checking and updating the timer
                heartbeat: 1,
                // extends the session when the mouse is moved
                extendOnMouseMove: true,
                // seconds between extending the session when the mouse is moved
                mouseDebounce: 30,
                // on mouse move function
                onMouseMove: function (timeout) {
                    //request the session extend page
                    $.get(timeout.options.extendUrl, function () {
                        //reset expiration
                        timeout.resetExpiration();
                    });
                },
                // custom URL
                //extendUrl: '/Login/RefreshSession',
                extendUrl: '',
                logoutUrl: '@Url.Action("LogOut", "Login")',
                loginUrl: '@Url.Action("SessionTimeOut", "Login")',
                // seconds before timeout to fire the next callback
                secondsPrior: 30,
                // resets the timer with mouse move while the dialog is visible and hide it
                triggerResetOnAlert: false,

                onClickExtend: function (timeout) {
                    /* Request dashboard to increase session */
                    $.get(timeout.options.extendUrl);
                    timeout.resetExpiration();
                },

                onTimeout: function (timeout) {

                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("SessionTimeOut", "Login")',
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            if (!data.success) {

                            } else {

                                window.location.href = "@Url.Action("Logout", "Login")";
                            }
                        },
                        error: function (data) {
                            $.confirm({
                                title: 'Session Refresh',
                                content: "Please manually log out and back in to refresh the session.",
                                type: 'red',
                                typeAnimated: true,
                                buttons: {
                                    Okay: {
                                        text: 'Okay'
                                    }
                                }
                            });
                        }

                    });

                    $.get(timeout.options.logoutUrl);
                },

                onSessionExtended: function (timeout) {
                    $('#jTimedoutAlert').closeAlert();
                },

                onPriorCallback: function (timeout, seconds) {
                    $.jAlert({
                        'id': 'jTimeoutAlert',
                        'title': 'Logout?',
                        'content': '<b>You have been inactive for too long, you will be forced to log out in <span class="jTimeout_Countdown">' + seconds + '</span> seconds.</b>',
                        'theme': 'blue',
                        'closeBtn': false,
                        'onOpen': function (alert) {
                            timeout.startPriorCountdown(alert.find('.jTimeout_Countdown'));
                        },
                        'btns': [
                            {
                                'text': 'Continue Session',
                                'theme': 'blue',
                                'onClick': function (e, btn) {
                                    e.preventDefault();
                                    timeout.options.onClickExtend(timeout);
                                    btn.parents('.jAlert').closeAlert();
                                    return false;
                                }
                            },
                            {
                                'text': 'Logout Now',
                                'onClick': function (e, btn) {
                                    e.preventDefault();
                                    window.location.href = timeout.options.logoutUrl;
                                    return false;
                                }
                            }
                        ]
                    });
                }
            });
        });


            const toggle = {
                block: 'none',
                none: 'block'
            }

            function ToggleMenu(event) {
                event.stopPropagation();
                event.target.classList.toggle('active');
                event.target.firstElementChild.style.display = toggle[event.target.firstElementChild.style.display] || 'block';
            }
            var menuParents = document.querySelectorAll("#my-menu .parent");
            menuParents.forEach(menuParent => {
                menuParent.addEventListener("click", ToggleMenu);
            })
        $('#someID').click(function () {
            $.ajax({
                dataType: 'native',
                url: "/Views/Support/BrowserModule/Syml_DF+Brower Module User Guide _V1.0.pdf",
                xhrFields: {
                    responseType: 'blob'
                },
                success: function (blob) {
                    console.log(blob.size);
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.download = "Syml_DF+Brower Module User Guide _V1.0.pdf";
                    link.click();
                }
            });
        });

            //$('#sidebar-wrapper').mouseover(function () {
            //    debugger
            //    $('#sidebar-wrapper').addClass('sidewidth1');
            //    $('#sidebar-wrapper').removeClass('sidewidth');


            //});
            //$('#sidebar-wrapper').mouseout(function () {
            //    debugger
            //    $('#sidebar-wrapper').addClass('sidewidth');
            //    $('#sidebar-wrapper').removeClass('sidewidth1');



            //});



        //var newdate = moment().format("Do MMM YYYY");
        //document.getElementById("DateTime").innerHTML = newdate;


        $('#NavLogOut').click(function () {
            $.confirm({
                title: 'Log Out!',
                content: 'Are you sure you want to log out?',
                type: 'orange',
                typeAnimated: true,
                buttons: {
                    yes: {
                        text: 'Yes',
                        btnClass: 'btn-red',
                        action: function () {
                            window.location.href = "@Url.Action("LogOut","Login")";
                        }
                    },
                    no: {
                        text: 'No',
                        btnClass: 'btn-green'
                    }
                }
            });
        });

        $('#HeaderLogOut').click(function () {
            $.confirm({
                title: 'Log Out!',
                content: 'Are you sure you want to log out?',
                type: 'orange',
                typeAnimated: true,
                buttons: {
                    yes: {
                        text: 'Yes',
                        btnClass: 'btn-red',
                        action: function () {
                            window.location.href = "@Url.Action("LogOut","Login")";
                        }
                    },
                    no: {
                        text: 'No',
                        btnClass: 'btn-green'
                    }
                }
            });
        });

        $("#menu-toggle").click(function (e) {
            e.preventDefault();
            /* $("#wrapper").toggleClass("menuDisplayed");*/
            $('#sidebar-wrapper').toggleClass('sidewidth');
        });
            </script>
</body>
