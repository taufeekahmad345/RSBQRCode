
@model IEnumerable<DF_WebModule.Models.clsCustomer>

<div class="container" style="max-width:100%">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <div id="ItemIndex">
                <table id="customers" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>S.No.</th>
                            <th>Customer Id</th>
                            <th>Customer Name</th>
                            <th>Address</th>
                            <th>City</th>
                            <th>State</th>
                            <th>PIN</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Mobile</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="TableResultsBody">
                        @foreach (var item in Model)
                        {
                        <tr>
                            <td>
                                <button type="button" class="btn btn-success btnedititem" id="@item.Id"><i class="fa fa-edit" title="Edit Item" aria-hidden="true"></i></button>
                                <button type="button" class="btn btn-danger btndeleteitem" id="@item.Id"><i class="fa fa-trash" title="Delete Item" aria-hidden="true"></i></button>
                            </td>
                            <td>@item.SNo</td>

                            <td>@item.CustomerId</td>
                            <td>@item.CustomerName</td>
                            <td>@item.Address</td>
                            @*<td>@item.SerialNo</td>*@
                            <td>@item.City</td>
                            <td>@item.State</td>
                            <td>@item.PinCode</td>
                            <td>@item.Email1</td>
                            <td>@item.Phone</td>
                            <td>@item.Mobile</td>
                            <td>@item.Status</td>



                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
<script>

    $(document).ready(function () {

        $('#customers').DataTable({
            scrollX: true,
            scrollCollapse: true,
            "columnDefs": [
                { "targets": 0, "type": "date-euro" },

            ],
            "order": [[1, "desc"]],
        });
    });


</script>
