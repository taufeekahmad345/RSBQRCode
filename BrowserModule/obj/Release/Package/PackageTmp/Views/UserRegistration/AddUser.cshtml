@model DF_WebModule.Models.UserDetailsModel
<style>
    .Highlight {
        background: #ff0000;
    }
</style>
@*@using (Html.BeginForm("", "", FormMethod.Post))
    {*@
@Html.AntiForgeryToken()

<div class="form-horizontal">

    <div class="row" style=" background-color: #018798;height: 40px; border-radius:5px">
        <div class="col-sm-12 col-lg-12" style="margin:auto">
            <h4 style="color: aliceblue;">Add User Detail</h4>
        </div>
    </div>
    <div class="row TablePanel">
        <div class="col-sm-12 col-lg-12">
            <div class="row">
                <div class="col-sm-4 col-md-4 col-lg-4">

                    @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-12" })
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-warning" })

                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control fontsize", id = "name" } })

                </div>
                <div class="col-sm-4 col-md-4 col-lg-4">
                    @Html.LabelFor(model => model.Mobile, htmlAttributes: new { @class = "control-label col-md-6" })

                    @Html.EditorFor(model => model.Mobile, new { htmlAttributes = new { @class = "form-control fontsize", id = "mobile" } })

                </div>
                <div class="col-sm-4 col-md-4 col-lg-4">
                    @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label col-md-6" })

                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control fontsize", id = "email" } })

                </div>

            </div>
            <div class="row">
                <div class="col-sm-4 col-md-4 col-lg-4">
                    @Html.LabelFor(model => model.UserName, htmlAttributes: new { @class = "control-label" })
                    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-warning" })
                    @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control fontsize", id = "username" } })
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4">
                    @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label col-md-6" })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-warning" })
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control fontsize", id = "password" } })
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4">
                    @Html.ValidationMessageFor(model => model.RoleId, "", new { @class = "text-warning" })
                    @Html.LabelFor(model => model.Role, htmlAttributes: new { @class = "control-label col-md-6" })
                    @{
                        List<SelectListItem> role = new List<SelectListItem>();
                        //foreach (var item in Model.roles)
                        //{
                        role.Add(new SelectListItem
                        {
                            Text = "Super Admin",
                            Value = "1",
                        });
                        role.Add(new SelectListItem
                        {
                            Text = "Admin",
                            Value = "2",
                        });
                        role.Add(new SelectListItem
                        {
                            Text = "Operater",
                            Value = "3",
                        });


                    }
                    @*}*@

                    @Html.DropDownListFor(model => model.RoleId, role, "Select Role", new { @class = "form-control fontsize", @id = "selectrole" })
                </div>
            </div>   
           
            <div class="row" style=" float: left; margin-top: 30px;">
                <div class="col-sm-12 col-md-12 col-lg-12">
                    <input value="Save" id="AddNewUser" type="button" class="btn btn-success" />

                    <input id="Cancel" type="button" value="Cancel" class="btn btn-danger" />
                </div>
            </div>
        </div>
      

        </div>
    </div>
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")



