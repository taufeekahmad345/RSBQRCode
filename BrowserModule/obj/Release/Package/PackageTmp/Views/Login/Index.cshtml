    $('#update-password').click(function () {
      window.location.href = "@Url.Action("SendEmail", "Login")";

    });

    $('#submitemail').click(function () {
             var email = $('#email').val();
            var data = {
                Email: email
        };
        $('#emailScenario').modal('hide');
        $('#divLoading').modal('show');
            $.ajax({
                type: "POST",
                url: '@Url.Action("ForgetPassword", "Login")',
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    $('#divLoading').modal('hide');
                    if (response.success) {
                        $.confirm({
                                     title: 'Email send successfully',
                                     content: response.responseText,
                                     type: 'green',
                                     autoClose: false,
                                     typeAnimated: true,
                                     buttons:
                                     {
                                         ReturnPatientSearch: {
                                             text: 'OK',
                                             action: function () {
                                                 document.getElementById('emailScenarioForm').reset();
                                                 window.location.href = "@Url.Action("ValidateOTP", "Login")";
                                             }
                                         }
                                     },
                                     titleClass: 'my-title-class'
                        });
                    } else {
                        $('#divLoading').modal('hide');
                        $.confirm({
                                     title: 'Email not send',
                                     content: response.responseText,
                                     type: 'red',
                                     typeAnimated: true,
                                     buttons:
                                     {
                                         ReturnPatientSearch: {
                                             text: 'OK',
                                             action: function () {
                                                 document.getElementById('emailScenarioForm').reset();
                                                 $('#divLoading').modal('hide');
                                             }
                                         }
                            },
                            timeout: 99999999,
                            titleClass: 'my-title-class'
                        });
                    }
                },
                error: function (error) {
                    console.error('Error while sending email: ', error);
                    $('#divLoading').modal('hide');
                    $.confirm({
                        title: 'Email not send',
                        content: response.responseText,
                        type: 'red',
                        typeAnimated: true,
                        buttons:
                        {
                            ReturnPatientSearch: {
                                text: 'OK',
                                action: function () {
                                    document.getElementById('emailScenarioForm').reset();
                                    $('#divLoading').modal('hide');
                                }
                            }
                        },
                        titleClass: 'my-title-class'
                    });
                }
            });
        });



</script>

    </body>
</html>
