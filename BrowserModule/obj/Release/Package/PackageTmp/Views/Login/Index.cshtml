@model DF_WebModule.Models.LoginModal

@{
    Layout = null;
}

<!DOCTYPE html>
<style>
 
    .cookie-consent-banner {
        position: fixed;
        bottom: 0;
        left: 0;
        z-index: 2147483645;
        box-sizing: border-box;
        width: 100%;
        background-color: #302929;
    }

    .cookie-consent-banner__inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 32px 0;
    }

    .cookie-consent-banner__copy {
        margin-bottom: 16px;
    }

    .cookie-consent-banner__actions {
    }

    .cookie-consent-banner__header {
        margin-bottom: 8px;
        font-family: "CeraPRO-Bold", sans-serif, arial;
        font-weight: normal;
        font-size: 16px;
        line-height: 24px;
    }

    .cookie-consent-banner__description {
        font-family: "CeraPRO-Regular", sans-serif, arial;
        font-weight: normal;
        color: #838F93;
        font-size: 16px;
        line-height: 24px;
    }

    .cookie-consent-banner__cta {
        box-sizing: border-box;
        display: inline-block;
        min-width: 164px;
        padding: 11px 13px;
        border-radius: 2px;
        background-color: #2CE080;
        color: #FFF;
        text-decoration: none;
        text-align: center;
        font-family: "CeraPRO-Regular", sans-serif, arial;
        font-weight: normal;
        font-size: 16px;
        line-height: 20px;
    }

    .cookie-consent-banner__cta--secondary {
        padding: 9px 13px;
        border: 2px solid #3A4649;
        background-color: transparent;
        color: #2CE080;
    }

    .cookie-consent-banner__cta:hover {
        background-color: #20BA68;
    }

    .cookie-consent-banner__cta--secondary:hover {
        border-color: #838F93;
        background-color: transparent;
        color: #22C870;
    }

    .cookie-consent-banner__cta:last-child {
        margin-left: 16px;
    }


    .my-title-class {
        color: black;
    }
    .textinput {
        width: 300px;
        border: 1px solid #ced4da;
        height: calc(1.5em + 0.75rem + 10px);
        border-radius: 0.25rem;
        position: revert-layer !important;
        box-sizing: border-box;
        height: auto;
        padding: 10px;
        font-size: 16px;
    }
    

    .jconfirm .jconfirm-box div.jconfirm-content-pane .jconfirm-content {
        color: black !important;
    }
    .password-container {
        position: relative;
        /* Additional styles for the container if needed */
    }
    .form-signin input {
        margin-bottom: 18px !important;
    }
    .toggle-password {
        position: absolute;
        right: 10px;
        top: calc(46% - 11.8px); /* Adjust positioning if needed */
        cursor: pointer;
        color: #aaa;
    }
    .toggle-password:hover {
            color: #333;
        }
    .error {
        color: #FEFAAA !important;
    }
    
</style>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - RSB</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/Login.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
    
</head>
<body class="text-center" style="background: #94eded">


    @using (Html.BeginForm("Authorise", "Login", FormMethod.Post, new { @class = "form-signin", @id = "loginform", Location = Request.QueryString["Location"], ReturnUrl = Request.QueryString["ReturnUrl"] }))
    {
    <div class="container">
        <div class="row">
          
            <div class="col-sm-12 col-md-12 col-lg-12">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <img class="login-logo" src="~/Content/Images/sitelogo1.jpg" alt="" width="250">
                <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1>
                <label class="error">@ViewBag.error</label>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">
                @*<button id="DownloadExcel" type="button" class="btn btn-primary" style="background: #007bff; border-color: #018798; "><i class="fa fa-download" aria-hidden="true"></i>&nbsp; Download Excel</button>*@

                <label for="inputUsername" class="sr-only">Username</label>
                @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-warning" })

                @Html.EditorFor(model => model.Username, new { htmlAttributes = new { placeholder = "Username", @class = "form-control mb-4" } })
            </div>
        </div>

        <div class="password-container row">
            <div class="col-sm-12 col-md-12 col-lg-12">
                @Html.LabelFor(model => model.Password, "Password", new { @class = "sr-only" })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-warning" })
                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { placeholder = "Password", @class = "textinput form-control", @id = "inputPassword" } })
            </div>

        </div>
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">
                <button class="btn btn-lg btn-primary btn-block btn-sign-in" type="submit">Sign in</button><br />
                <label class="text-warning">@ViewBag.check</label>
                <p class="mt-3 mb-3">&copy; @DateTime.Now.Date.ToString("dd-MM-yyyy") - Powerd by Wide Seva </p>
            </div>
        </div>
    </div>
            }

      





        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")

<script type="text/javascript">
    $(document).ready(function () {
            @if (ViewBag.within30Days)
            {
                <text>
        $.confirm({
            title: '<h3 style="color:black;">License Key Notice</h3>',
            content: '<div style="color:black;">Your license key is due to expire in <b>@ViewBag.DateOfExpiry days</b><br/>To renew your license, please click on the button below:<form action="@Url.Action("Index", "Activation").ToString()"><button class="btn btn-primary btn-block btn-sign-in" type="submit">Renew License</button></form></div>',
            type: 'red',
            typeAnimated: true,
            buttons: {
                Okay: {
                    text: 'Close'
                }
            }
        });
                </text>
                }
    });
        $("#privacy").click(function () {
            $('#privacypopup').modal('show');
        })
        $("#privacyclose").click(function () {
            $('#privacypopup').modal('hide');
        })
        $("#closemodel").click(function () {
            $('#privacypopup').modal('hide');
        })
        $("#removefooter").click(function () {
            $("#cookie").remove();
        })
        $("#closefooter").click(function () {
            $("#cookie").remove();
        })
            $('#DownloadExcel').click(function () {

                $.ajax({
                    url: '@Url.Action("ExcelData", "DocumentUpload")',
                    method: 'Get',

                    xhrFields: {
                        responseType: 'blob' // Set the response type as blob
                    },
                    success: function (data) {
                        // Create blob object and initiate download
                        var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                        var link = document.createElement('a');
                        link.href = window.URL.createObjectURL(blob);
                        link.download = 'ExcelData.xlsx';
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    },
                    error: function (xhr, status, error) {
                        console.error('Error downloading Excel file:', error);
                        alert('Failed to download Excel file.');
                    }
                });
            });
    function togglePasswordVisibility() {
        debugger;
            var passwordField = document.getElementById("inputPassword");
            var eyeIcon = document.getElementById("eyeIcon");

            if (passwordField.type === "password") {
                passwordField.type = "text";
                eyeIcon.classList.remove("fa-eye");
                eyeIcon.classList.add("fa-eye-slash");
            } else {
                passwordField.type = "password";
                eyeIcon.classList.remove("fa-eye-slash");
                eyeIcon.classList.add("fa-eye");
            }
        }


    function GoToSettings() {
        $.confirm({
            content: '' +
                '<form action="" class="formName">' +
                '<div class="form-group">' +
                '<label style="color:black;">Please enter the password</label>' +
                '<input type="password" placeholder="" class="name form-control" required />' +
                '</div>' +
                '</form>',
            buttons: {
                formSubmit: {
                    text: 'Submit',
                    btnClass: 'btn-blue',
                    action: function () {
                        var name = this.$content.find('.name').val();
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("LoginSetting", "Login")',
                            data: '{"Password":"' + name + '"}',
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function (data) {
                                if (data.success == false) {
                                    $.alert({
                                        title: 'Prompt!',
                                        content: '<label style="color:black;">Wrong Password, please try again</label>',
                                        cancel: function () {
                                            //close
                                        }
                                    });
                                }
                                if (data.responseText == "FrequncySetting") {

                                    window.location.href = "@Url.Action("Frequencydate", "Settings")";

                                }
                                if (data.responseText == "ConfigSetting") {
                                    window.location.href = "@Url.Action("Index", "Settings")";
                                }
                                if (data.responseText == "AutoSMSConfig")
                                {
                                    window.location.href = "@Url.Action("AutoSMSConfig", "Settings")";
                                }

                            },
                        });

                    }
                },
                cancel: function () {
                    //close
                },
            },
            onContentReady: function () {
                // bind to events
                var jc = this;
                this.$content.find('form').on('submit', function (e) {
                    // if the user submits the form by pressing enter in the field.
                    e.preventDefault();
                    jc.$$formSubmit.trigger('click'); // reference the button and click it
                });
            }
        });

    }

    function resetModal() {
        document.getElementById('emailScenarioForm').reset();

        }

