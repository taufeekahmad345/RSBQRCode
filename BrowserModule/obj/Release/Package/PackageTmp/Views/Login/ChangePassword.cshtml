@model DF_WebModule.Classes.ChangePassword
<style>
    .rowh {
        margin-top: -5px;
    }

    .colu {
        margin-left: -300px;
        border: solid;
    }
</style>

<div class="form-horizontal">
    <div class="row" style=" background-color: #018798;height: 40px; border-radius:5px">
        <div class="col-sm-12 col-lg-12" style="margin:auto">
            <h4 style="color: aliceblue; text-align:center">Change Password</h4>
        </div>
    </div>
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row rowh">
        <div class="col-sm-4 col-md-4 col-lg-4">
            <label>Old Password : </label>
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3">
            @Html.EditorFor(model => model.OldPassword, new { htmlAttributes = new { @class = "form-control colu", @id = "old" } })
            @Html.ValidationMessageFor(model => model.OldPassword, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row rowh">
        <div class="col-sm-4 col-md-4 col-lg-4">
            <label>New Password</label>
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3">
            @Html.EditorFor(model => model.NewPassword, new { htmlAttributes = new { @class = "form-control colu", @id = "new" } })
            @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row rowh">
        <div class="col-sm-4 col-md-4 col-lg-4">
            <label>Confirm Password</label>
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3">
            @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @class = "form-control colu", @id = "confirm" } })
            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="row">
        <div class="col-sm-4 col-md-4 col-lg-4">
            <button type="submit" id="changepassword" style=" width: 100px; margin-left: 220px;">Change</button>
        </div>
    </div>

</div>
<script>



    $('#confirm').on('input', function () {
        debugger
        var password = $('#new').val();
        var confirmPassword = $(this).val();

        if (password !== confirmPassword) {
            mismatchMessage = "New password and confirm password should match";
            changepassword.disabled = true;
            // To hide the error message with class "error text-center"
            //$('.error').hide();
            $('#errorMessage').text(mismatchMessage);        }
        else {
            $('#errorMessage').text('');
            changepassword.disabled = false;
            $('.error').show();
        }
    });

    $('#new').on('input', function () {
        debugger
        var confirmpassword = $('#confirm').val();
        var newPassword = $(this).val();

        if (confirmpassword !== newPassword) {

            changepassword.disabled = true;
        }
        else {

            changepassword.disabled = false;
        }

    });

    $("#changepassword").click(function () {
        var data = {
            NewPassword: $('#confirm').val(),
            OldPassword: $('#old').val()
           
        };
          $.ajax({
                type: "POST",
                url: '@Url.Action("ChangePassword", "Login")', // Replace with your controller method URL
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    $("#divLoading").hide();
                    if (response.success) {
                        $('#divLoading').modal('hide');
                        $.confirm({
                            title: 'Password Updated Successfully',
                            content: response.responseText,
                            type: 'green',
                            typeAnimated: true,
                            buttons:
                            {
                                ReturnPatientSearch: {
                                    text: 'OK',
                                    action: function () {
                                        window.location.href = "@Url.Action("Index","Login")";
                                    }
                                }
                            },
                            titleClass: 'my-title-class'
                        });
                    }
                    else {
                        $.confirm({
                            title: 'Error in updating password',
                            content: response.responseText,
                            type: 'red',
                            typeAnimated: true,
                            buttons:
                            {
                                ReturnPatientSearch: {
                                    text: 'OK',
                                    action: function () {
                                    }
                                }
                            }
                        });
                    }
                }

            });

    })

</script>