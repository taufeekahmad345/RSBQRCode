@model DF_WebModule.Models.DashboardModel
@{
    ViewBag.Title = "Dashboard";
}   
<style>
    .Delete-Patient-Notification-Row {
        background: #077af5 !important;
        color: white !important;
    }
    .textcolor {
        color: aliceblue !important;
    }
    div.dataTables_wrapper div.dataTables_filter {
        text-align: right;
        padding-right: 50px;
    }

    div.dataTables_wrapper div.dataTables_paginate {
        padding-right: 50px;
    }

</style>
@Html.AntiForgeryToken()  
<div class="container" style="width:100%">
    @Html.EditorFor(model => model.ReportId, new { htmlAttributes = new { @class = "reportid", @style = "display:none" } })

    <div class="row">
        <div class="col-sm-4 col-lg-4">
            <div class="card" style="width: 20rem; line-height: 0.1 !important; background: #348993;">
                <p style="padding:15px !important" class="textcolor">@Model.Totalproduction No.</p>
                <div class="card-body" style="padding-top: 5px !important; padding-bottom: 3px !important;">
                    <h6 class="card-title textcolor">Total Production</h6>
                </div>
                <div class="card-footer text-muted textcolor" onclick="GetTotal(1)" style="line-height: 0rem !important; text-align: center; cursor:pointer;">
                    More Info  <a class="fa fa-arrow-circle-o-right textcolor" style="line-height: inherit;"></a>
                </div>
            </div>

        </div>

        <div class="col-sm-4 col-lg-4">
            <div class="card" style="width: 20rem; line-height: 0.1 !important; background: #ae632e;">
                <p style="padding:15px !important" class="textcolor">@Model.TotalPDI No.</p>
                <div class="card-body textcolor" style="padding-top: 5px !important; padding-bottom: 3px !important;">
                    <h6 class="card-title">Total PDI</h6>
                </div>
                <div class="card-footer text-muted textcolor" onclick="GetTotal(2)" style="line-height: 0rem !important; text-align: center; cursor: pointer;">
                    More Info  <a class="fa fa-arrow-circle-o-right textcolor" style="line-height: inherit;"></a>
                </div>
            </div>
        </div>

        <div class="col-sm-4 col-lg-4">
            <div class="card" style="width: 20rem; line-height: 0.1 !important; background: #c05aec;">
                <p style="padding:15px !important" class="textcolor">@Model.RejectedPart No.</p>
                <div class="card-body textcolor" style="padding-top: 5px !important; padding-bottom: 3px !important;">
                    <h6 class="card-title">Rejected Part</h6>
                </div>
                <div class="card-footer text-muted textcolor" onclick="GetTotal(3)" style="line-height: 0rem !important; text-align: center; cursor: pointer;">
                    More Info  <a class="fa fa-arrow-circle-o-right textcolor" style="line-height: inherit;"></a>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-3 col-md-3 col-lg-3">
            @Html.LabelFor(model => model.FromDate, htmlAttributes: new { @class = "control-label col-md-12" })
            <div class="form-group">
                <input class="form-control form-control-sm datepicker fontsize" style="height: 40px; font-size: x-large;" value="@Model.ToDate" onchange="OnChangeValue()" id="fromdatevalue" type="text" placeholder="dd/mm/yyyy">

            </div>
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3">
            @Html.LabelFor(model => model.ToDate, htmlAttributes: new { @class = "control-label col-md-12" })
            <div class="form-group">
                <input class="form-control form-control-sm datepicker fontsize" style="height: 40px; font-size: x-large;" value="@Model.ToDate" onchange="OnChangeValue()" id="todate" type="text" placeholder="dd/mm/yyyy">

            </div>
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3">

            @Html.LabelFor(model => model.Plant, htmlAttributes: new { @class = "control-label col-md-6" })
            @{
                List<SelectListItem> plant = new List<SelectListItem>();
                foreach (var item in Model.plants)
                {
                    plant.Add(new SelectListItem
                    {
                        Text = item.Name,
                        Value = item.Id.ToString(),
                    });
                }
            }
            @Html.DropDownListFor(model => model.plants, plant, "Select Plant", new { @class = "form-control fontsize", @onchange = "OnChangeValue()", @id = "selectplant" })
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3">

            @Html.LabelFor(model => model.Customer, htmlAttributes: new { @class = "control-label col-md-6" })
            @{
                List<SelectListItem> cus = new List<SelectListItem>();
                foreach (var item in Model.customers)
                {
                    cus.Add(new SelectListItem
                    {
                        Text = item.Name,
                        Value = item.Id.ToString(),
                    });


                }
            }
            @Html.DropDownListFor(model => model.Customer, cus, "Select Customer", new { @class = "form-control fontsize", @onchange = "OnChangeValue()", @id = "selectcustomer" })
        </div>
    </div>
    <div id="LoadingIcon" style="display:none; text-align: center;">
        <i class="fa fa-spinner fa-pulse fa-3x fa-fw"></i>
        <span style="color: black">processing, please do not close this page...</span>
    </div>
    <div class="row" style="background-color: #018798; height: 35px; border-radius: 5px; margin-top: -15px; ">
        <div class="col-sm-3 col-lg-3">
            <h5 style="color: aliceblue; padding-top: 4px;" id="headerline">Production Part Details</h5>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <button id="DownloadExcelValidate" type="button" class="btn btn-primary" style="background: #007bff; border-color: #018798; "><i class="fa fa-download" aria-hidden="true"></i>&nbsp; Excel</button>

        </div>
    </div>
    <div class="box-body table-responsive-lg" style="margin-top: -45px;">
        <div id="updateTableList">
            @Html.Raw(Model.TableList)
        </div>

    </div>
</div>
@*<script src="//cdn.datatables.net/plug-ins/1.10.11/sorting/date-eu.js" type="text/javascript"></script>*@
<script>
    $("#todate").datepicker({
        format: 'dd/mm/yyyy',
        autoclose: true,
    });
    $("#fromdatevalue").datepicker({
        format: 'dd/mm/yyyy',
        autoclose: true,
    });
    function GetTotal(data) {
       
       
        var item = {};
        $('#LoadingIcon').modal('show');
        item.ReportId = data;
        var post = { item }
         $.ajax({
              type: "POST",
                  url: '@Url.Action("ProductFilder", "Home")',
                    data: JSON.stringify(post),
                    contentType: "application/json; charset=utf-8",
            success: function (result) {
                $("#divLoading").hide();
                if (data == "1") {
                    $("#headerline").text('Production Part Details');
                }
                if (data == "2") {
                    $("#headerline").text('PDI Part Details');
                }
                if (data == "3") {
                    $("#headerline").text('Rejected Part Details');
                }
                $('#LoadingIcon').modal('hide');
                $('#updateTableList').html(result);

            },
            error: function (r) {
                $("#divLoading").hide();
                //console.error("Error loading partial view:", status, error);
            }
        });
    }
    function OnChangeValue() {
        debugger
        var fromdate = $("#fromdatevalue").val();
        var todate = $("#todate").val();
        var plant = $("#selectplant").val();
        var customer = $("#selectcustomer").val();
        var item = {};
        item.FromDate = fromdate;
        item.ToDate = todate;
        item.Plant = plant;
        item.CustomerName = customer;
        item.ReportId = $(".reportid").val();
        var post = { item }
         $.ajax({
              type: "POST",
                  url: '@Url.Action("ProductFilder", "Home")',
                    data: JSON.stringify(post),
                    contentType: "application/json; charset=utf-8",
            success: function (result) {
                $("#divLoading").hide();
                $('#updateTableList').html(result);

            },
            error: function (r) {
                $("#divLoading").hide();
                //console.error("Error loading partial view:", status, error);
            }
        });

    };
    $('#DownloadExcelValidate').click(function () {
        debugger
        var fromdate = $("#fromdatevalue").val();
        var todate = $("#todate").val();
        var plant = $("#selectplant").val();
        var customer = $("#selectcustomer").val();
        var item = {};
        item.FromDate = fromdate;
        item.ToDate = todate;
        item.Plant = plant;
        item.CustomerName = customer;

        var post = { item }
        $.ajax({
            type: "POST",
                    url: '@Url.Action("ValidationData", "DocumentUpload")',
                    data: JSON.stringify(post),
                    contentType: "application/json; charset=utf-8",
                    xhrFields: {
                        responseType: 'blob' // Set the response type as blob
                    },
                    success: function (data) {
                        // Create blob object and initiate download
                        var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                        var link = document.createElement('a');
                        link.href = window.URL.createObjectURL(blob);
                        link.download = 'ExcelData.xlsx';
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    },
                    error: function (xhr, status, error) {
                        console.error('Error downloading Excel file:', error);
                        alert('Failed to download Excel file.');
                    }
                });
            });

    function GetAllitems() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("Index", "Home")',

            contentType: "application/json; charset=utf-8",
            beforeSend: function () {
                $("#divLoading").show();
                $("#ReturnedResponsesTab").hide()
                $('#updateCompletedQuestionnaireTable').html('');
            },
            success: function (data) {
                $("#divLoading").hide()
                $("#ReturnedResponsesTab").show()
                $('#updateCompletedQuestionnaireTable').html(data);
                $('#returnedResponsesTable').DataTable({
                    "order": [[8, "desc"]],
                    "columnDefs": [{ "targets": 8, "type": "date-euro" }],
                });
            },
            error: function (r) {
            }
        });
    }




</script>