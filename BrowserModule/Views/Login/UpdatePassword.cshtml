@model DF_WebModule.Models.UpdatePasswordModel

@{
    Layout = null;
}

<!DOCTYPE html>
<style>
    .btn-primary.disabled, .btn-primary:disabled {
        background-color: #c70079 !important;
        border-color: #c70079 !important;
    }
    .my-title-class {
        color: black;
    }
    .textinput {
        width: 300px;
        border: 1px solid #ced4da;
        height: calc(1.5em + 0.75rem + 10px);
        border-radius: 0.25rem;
        position: revert-layer !important;
        box-sizing: border-box;
        height: auto;
        padding: 10px;
        font-size: 16px;
    }
    .jconfirm .jconfirm-box div.jconfirm-content-pane .jconfirm-content {
        color: black !important;
    }
    .password-container {
        position: relative;
        /* Additional styles for the container if needed */
    }

    .toggle-password {
        position: absolute;
        right: 10px;
        top: calc(70% - 10px); /* Adjust positioning if needed */
        cursor: pointer;
        color: #aaa;
    }

        .toggle-password:hover {
            color: #333;
        }

    .error {
        color: #FEFAAA !important;
    }
    #errorMessage {
        color: #FEFAAA !important;
    }
</style>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>UpdatePassword</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/Login.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-signin", @id = "loginform" }))
    {
        @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <img class="login-logo" src="~/Content/Images/Syml-Header-Logo.png" alt="" width="250" style=" margin-left: 23px !important;">
        <h4 class="mb-3 font-weight-normal">Create or Change Password</h4>
        <label id="errorMessage" class="text-warning"></label>
        <label class="error" style="text-align:left !important;">
            Password must have at least 8 characters:
            <br />Must include:
            <br />1 CAPITAL letter
            <br />1 lower case letter
            <br />1 digit and 1 special character,
            <br />@@, #, -, $, £, _
            <br />to enable saving
        </label>
            @*<label class="text-warning">@ViewBag.error</label>*@
            <div class="password-container">
                <label for="password" class="password mt-3">Enter new password:</label>
                @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-warning" })
                @Html.PasswordFor(model => model.NewPassword, new { placeholder = "New Password", @class = "textinput form-control", @id = "newPassword" })
                <span class="toggle-password" onclick="togglePasswordVisibility('newPassword', 'eyeIconNew')">
                    <i id="eyeIconNew" class="fa fa-eye"></i>
                </span>
            </div>

            <div class="password-container">
                <label for="password" class="password mt-2">Confirm new password:</label>
                @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-warning" })
                @Html.PasswordFor(model => model.ConfirmPassword, new { placeholder = "Confirm Password", @class = "textinput form-control", @id = "confirmPassword" })
                <span class="toggle-password" onclick="togglePasswordVisibility('confirmPassword', 'eyeIconConfirm')">
                    <i id="eyeIconConfirm" class="fa fa-eye"></i>
                </span>
            </div>



            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @style = "display:none", @id = "emailid" } })

            <button class="btn btn-lg btn-primary btn-block btn-sign-in mt-4" type="submit" id="updatepwd" disabled>Save Password</button>
            <p class="mt-4 mb-3 text-center">&copy; @DateTime.Now.Year - SymlConnect</p>
    </div>
    }

    <img class="" src="~/Content/Images/frimley-health-and-care-logo.png" alt="" width="300" style="display:block; margin-top:800px; position:fixed;">
   

    <!--Loading Modal-->
    <div class="modal fade" id="divLoading" tabindex="-1" role="dialog" aria-labelledby="Loading" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="row" style="width:100%; position: relative;">
                <div class="col-12 d-flex justify-content-center" style="position: absolute; top: 20px; width: 100%;">
                    <div id="loadingText" style="color: white; text-align: center;">processing, please do not close this page</div>
                </div>
                <div class="justify-content-center" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
                    <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
                        <span id="loadingCircle" class="sr-only">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")

<script type="text/javascript">
    $('.btn-sign-in').prop('disabled', true);



    $('#newPassword').on('input', function ()
    {
        var password = $('#newPassword').val();
        var errorMessages = '';

        // Regular expression for validating the password format
        var passwordRegex = "^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{8,20}$";
        if (password.length < 8 || !password.match(/[A-Z]/)
            || !password.match(/\d/) || !password.match(/[@@#\-_]/)) {
            //errorMessages += 'Password must be at least 8 characters, including 1 CAPITAL letter, 1 digit and 1 special character: @@,#, - or _ to enable Save tab';
            }
        if (errorMessages !== '') {
            // To hide the error message with class "error text-center"
            $('.error').hide();
                $('#errorMessage').html(errorMessages);
                
                event.preventDefault(); 
            } else {
            $('#errorMessage').html('');
            $('.error').show();
            }
    });



    $('#confirmPassword').on('input', function () {
        var password = $('#newPassword').val();
        var confirmPassword = $(this).val();
        var errorMessages = '';
        if (password.length < 8 || confirmPassword.length < 8) {
            updatepwd.disabled = true;
        }
        else {
            updatepwd.disabled = false;
        }

        if (password !== confirmPassword) {
            mismatchMessage = "New password and confirm password should match";
            // To hide the error message with class "error text-center"
            $('.error').hide();
            $('#errorMessage').text(mismatchMessage);
           

        }
        else {
            $('#errorMessage').text('');
            $('.error').show();
        }
        $('.btn-sign-in').prop('disabled', password.length < 8 || confirmPassword.length < 8 || password !== confirmPassword);
    });



    $('#loginform').submit(function (e) {
        console.log("Form submitted"); // Check if form submission event is captured
        e.preventDefault();
        var newPassword = $('#newPassword').val();
        var confirmPassword = $('#confirmPassword').val();
        var email = $('#emailid').val();
        var mismatchMessage = "";

            // Check if the new password matches the confirmation password


            var data = {
                newPassword: newPassword,
                confirmPassword: confirmPassword,
                email: email
            };
        $('#divLoading').modal('show');
            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdatePassword", "Login")', // Replace with your controller method URL
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    $("#divLoading").hide();
                    if (response.success)
                    {
                        $('#divLoading').modal('hide');
                         $.confirm({
                                     title: 'Password Updated Successfully',
                                     content: response.responseText,
                                     type: 'green',
                                     typeAnimated: true,
                                     buttons:
                                     {
                                         ReturnPatientSearch: {
                                             text: 'OK',
                                             action: function () {
                                                window.location.href = "@Url.Action("Index","Login")";
                                             }
                                         }
                             },
                                      titleClass: 'my-title-class'
                       });
                    }
                    else
                    {
                       $.confirm({
                                     title: 'Error in updating password',
                                     content: response.responseText,
                                     type: 'red',
                                     typeAnimated: true,
                                     buttons:
                                     {
                                         ReturnPatientSearch: {
                                             text: 'OK',
                                             action: function () {
                                             }
                                         }
                                     }
                                });
                    }
                }

            });
    });

    function togglePasswordVisibility(passwordId, eyeIconId) {
        var passwordField = document.getElementById(passwordId);
        var eyeIcon = document.getElementById(eyeIconId);

        if (passwordField && eyeIcon) {
            if (passwordField.type === "password") {
                passwordField.type = "text";
                eyeIcon.classList.remove("fa-eye");
                eyeIcon.classList.add("fa-eye-slash");
                passwordField.addEventListener("input", function () {
                    if (passwordField.value.length === 0) {
                        passwordField.type = "password";
                        eyeIcon.classList.remove("fa-eye-slash");
                        eyeIcon.classList.add("fa-eye");
                    }
                });
            } else {
                passwordField.type = "password";
                eyeIcon.classList.remove("fa-eye-slash");
                eyeIcon.classList.add("fa-eye");
            }
        } else {
            console.error("Password field or eye icon not found.");
        }
    }

</script>
