        <div class="row">
            <div class="col-sm-4 col-md-4 col-lg-4">
                <button type="submit" id="AddSetting" style=" width: 100px; margin-left: 220px;">Set</button>
            </div>
        </div>

    </div>


<script>
    
    $("#AddSetting").click(function () {
        debugger
          var item = {};
        item.CompanyName = $("#cName").val();
        item.Address = $("#address").val();
        item.City = $("#city").val();
        item.PinNo = $("#pinno").val();
        item.Phone = $("#phone").val();
            item.Mobile = $("#mobile").val();
        item.Email = $("#email").val();
        item.Fax = $("#fax").val();
        item.TINNO = $("#tin").val();
        item.ExiceNo = $("#exice").val();
        item.CSTNo = $("#cst").val();
           $.ajax({
                type: "POST",
                url: '@Url.Action("AddSetting", "Customer")',
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(item),
                success: function (data) {
                    $.confirm({
                        title: 'Added Item',
                        content: "Added Successfully!",
                        type: 'green',
                        typeAnimated: true,
                        buttons: {
                            Okay: {
                                text: 'Okay',
                                action: function () {
                                    window.location.href = "@Url.Action("Setting", "Customer")";

                                }
                            }
                        }
                    });
                },
                error: function (data) {
                    $.confirm({
                        title: 'Unable to locate patient',
                        content: 'Unable to locate the patient record, please try again.',
                        type: 'red',
                        typeAnimated: true,
                        buttons: {
                            Okay: {
                                text: 'Okay'
                            }
                        }
                    });
                }
            });
    });
</script>                  