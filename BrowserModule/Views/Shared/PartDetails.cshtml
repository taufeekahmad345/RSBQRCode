@model IEnumerable<DF_WebModule.Models.EngineeringModel>

<div class="container" style="max-width:100%">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <div id="ItemIndex">
                <table id="validationdetailtable" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>S.No.</th>
                            <th>Part No</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Jt</th>
                            <th>Length</th>
                            <th>RevLvl</th>
                            <th>Customer Name</th>
                            <th>Remark</th>
                        </tr>
                    </thead>
                    <tbody id="TableResultsBody">
                        @foreach (var item in Model)
                        {
                        <tr>
                            <td>
                                <button type="button" class="btn btn-success btnedititem" id="@item.Id"><i class="fa fa-edit" title="Edit Item" aria-hidden="true"></i></button>
                                <button type="button" class="btn btn-danger btndeleteitem" id="@item.Id"><i class="fa fa-trash" title="Delete Item" aria-hidden="true"></i></button>
                            </td>
                            <td>@item.SRNo</td>

                            <td>@item.PartNumber</td>
                            <td>@item.Part_Description</td>
                            <td>@item.TypeOfPart</td>
                            @*<td>@item.SerialNo</td>*@
                            <td>@item.Joint</td>
                            <td>@item.Tube_Length</td>
                            <td>@item.ModNo</td>
                            <td>@item.CustomerName</td>
                            <td>@item.Remark</td>



                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
<script>

    $(document).ready(function () {

        $('#validationdetailtable').DataTable({
            scrollX: true,
            scrollCollapse: true,
            "columnDefs": [
                { "targets": 0, "type": "date-euro" },

            ],
            "order": [[1, "desc"]],
        });
    });
  

</script>
