@model IEnumerable<DF_WebModule.DBModel.UserDetail>

<div class="row">
    <div class="col-sm-6 col-lg-6 col-md-6" style="margin-top:10px">
       
            <table id="users" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0" style=" background: azure;">
                <thead>
                    <tr>
                        <th>S.NO.</th>
                        <th>Operator</th>
                        <th>Approved</th>
                        <th>Reject</th>
                    </tr>
                </thead>
                <tbody id="TableResultsBody">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.Id
                            </td>
                            <td>
                                @item.Name
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
       
    </div>
<script>
    $(document).ready(function () {

        $('#users').DataTable({
            scrollX: true,
            scrollCollapse: true,
            "columnDefs": [
                { "targets": 0, "type": "date-euro" },

            ],
            "order": [[1, "desc"]],
        });
    });


</script>